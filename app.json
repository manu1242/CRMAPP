{
  "expo": {
    "name": "UPropTech",
    "slug": "crm",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/Appicon.jpg",
    "splash": {
      "image": "./assets/images/splashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "crm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ultrakey.crm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/AdaptiveIcon.png"
      },
      "splash": {
        "backgroundColor": "#000000",
        "image": "./assets/images/splashscreen.png",
        "resizeMode": "contain"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ultrakey.crm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Appicon.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0C0C0C",
          "style": "light"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77acddcb-ef08-4cb4-8559-6a9b7b986d36"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/77acddcb-ef08-4cb4-8559-6a9b7b986d36"
    }
  }
}
