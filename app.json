{
  "expo": {
    "name": "UPropTech",
    "slug": "crm",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/ios/iTunesArtwork@2x.png",
    "scheme": "crm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ultrakey.crm",
      "icon": "./assets/images/ios/iTunesArtwork@2x.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "icon": "./assets/images/android/ic_launcher-web.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android/mipmap-xxxhdpi/icon_foreground.png",
        "monochromeImage": "./assets/images/android/mipmap-xxxhdpi/icon_monochrome.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ultrakey.crm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ios/iTunesArtwork@1x.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0C0C0C",
          "style": "light"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splashscreen.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splashscreen.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77acddcb-ef08-4cb4-8559-6a9b7b986d36"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
