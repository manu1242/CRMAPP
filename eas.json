{
  "cli": {
    "version": ">= 21.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "development"
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uproptech.com",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "preview"
    },

    "internal-testing": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uproptech.com",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "preview"
    },

    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uproptech.com",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "production"
    }
  },

  "submit": {
    "production": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      },
      "ios": {
  "appleId": "ultrakeyit@gmail.com",
  "ascAppId": "6816377854"
}
    }
  }
}